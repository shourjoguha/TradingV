# Railway backend (replica — receives TV webhooks, fallback inference).
# Set these as env vars in Railway dashboard. DATABASE_URL + PORT are auto-injected.

INSTANCE_NAME=railway

# Railway's own API key — protects /webhook and /v1/* on Railway.
API_KEY="Random key labubu trading view lets go"

# Peer = laptop. Railway pushes tickers to laptop after each job.
# NOTE: 192.168.10.187 is laptop LAN IP — only reachable when laptop is on same network
# as a request source. Railway can't reach a private IP directly; once you add a
# Cloudflare/Tailscale tunnel, swap this for the tunnel hostname.
PEER_API_URL=http://192.168.10.187:8000
PEER_API_KEY=SKBfJyza8WS4Ozs5NptH_jN_F5XcM8_19UgjND9GpdM

# Concurrency gate.
MAX_CONCURRENT_JOBS=1

# Kronos — enable only if you want Railway to do inference. CPU-only; slow.
KRONOS_ENABLED=true
DEBUG_STUB=false
