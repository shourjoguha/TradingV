# Railway backend env (replica). Set actual values in Railway dashboard → Variables.
# DATABASE_URL + PORT are auto-injected by Railway. NEVER commit real secrets here.

INSTANCE_NAME=railway

# Strong random key — generate with `openssl rand -base64 32`. Set in dashboard.
API_KEY=replace-with-strong-random-key-set-in-railway-dashboard

# Peer = laptop. Use a tunnel hostname (Tailscale/Cloudflare); never a LAN IP.
PEER_API_URL=https://<tunnel-hostname>:8000
PEER_API_KEY=replace-with-laptop-side-key-set-in-railway-dashboard

MAX_CONCURRENT_JOBS=1
KRONOS_ENABLED=true
DEBUG_STUB=false
