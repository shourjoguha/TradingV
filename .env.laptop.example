# Laptop backend (primary — runs Kronos inference locally).
# Copy to `.env.laptop` and load before `uvicorn app.main:app`.

INSTANCE_NAME=laptop

# Local dockerized Postgres on 5439 (see docker-compose.laptop.yml).
DATABASE_URL=postgresql+asyncpg://tradingview:qjcOg7j-K5GoPrFrC6AhUgr3EGBFqKjz@localhost:5439/tradingview

# Laptop's own API key — set this on clients (frontend, curl) hitting the laptop.
API_KEY=***ROTATED-PEER-KEY***

# Peer = Railway. Laptop pushes tickers to Railway after each job.
PEER_API_URL=https://tradingv-production.up.railway.app
PEER_API_KEY="***ROTATED-API-KEY***"

# Concurrency gate. Keep at 1 while Kronos is CPU-only.
MAX_CONCURRENT_JOBS=1

# Kronos
KRONOS_ENABLED=true
DEBUG_STUB=false
