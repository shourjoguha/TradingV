# Laptop env for running the Agents lane (TradingAgents) buy-review flow.
# Copy to `.env` (git-ignored) and fill in real values. See
# `.claude/modules/agents.md` and `scripts/agents_review.py`.

# --- Core (always required) -------------------------------------------------
API_KEY=replace-with-strong-random-key            # openssl rand -base64 32
# DB: Postgres (docker compose -f docker-compose.laptop.yml up -d, port 5439)
#   DATABASE_URL=postgresql+asyncpg://tradingview:tradingview@localhost:5439/tradingview
# ...OR skip docker entirely with SQLite (fine for the agents lane):
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# --- Agents lane ------------------------------------------------------------
AGENTS_ENABLED=true                               # swap the stub for the real engine
ANTHROPIC_API_KEY=                                # required by langchain-anthropic
CLAUDE_MODEL=claude-sonnet-4-6                    # default model for the debate
# Optional per-role overrides (empty => reuse CLAUDE_MODEL):
AGENTS_DEEP_MODEL=                                # heavier reasoning (debate/decision)
AGENTS_QUICK_MODEL=                               # cheaper passes + review extraction
AGENTS_LLM_PROVIDER=anthropic

# TradingAgents' online data path (news / fundamentals / insider). Without it
# the library is limited to its offline/cached tools.
FINNHUB_API_KEY=

# Debug-only: deterministic synthetic decisions with NO LLM/network. Never in
# production. Lets you exercise the review+report pipeline offline.
DEBUG_STUB=false
